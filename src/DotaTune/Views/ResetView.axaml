<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DotaTune.ViewModels"
             xmlns:res="using:DotaTune.Resources"
             x:Class="DotaTune.Views.ResetView"
             x:DataType="vm:ResetViewModel">
  <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Left">
    <TextBlock Classes="title" Text="{Binding Title}" />
    <TextBlock Classes="lead" Text="{Binding Description}" />

    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,14,0,0"
                  IsVisible="{Binding HasRows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <TextBlock Text="{Binding}" FontSize="16" TextWrapping="Wrap" Margin="0,6" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Classes="verdict" Classes.ok="{Binding IsOk}" Classes.attention="{Binding IsAttention}" Margin="0,14,0,0"
            IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid ColumnDefinitions="Auto,*">
        <Ellipse Classes="mark" Width="8" Height="8" VerticalAlignment="Top" Margin="0,8,12,0" />
        <StackPanel Grid.Column="1" Spacing="8">
          <TextBlock Classes="label" Text="{Binding Summary}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Grid>
    </Border>

    <Button Classes="pill accent" Content="{x:Static res:Strings.ResetAll}" Command="{Binding ResetCommand}"
            IsVisible="{Binding ShowReset}" HorizontalAlignment="Left" Margin="0,10,0,0" />

    <StackPanel Spacing="12" Margin="0,10,0,0" IsVisible="{Binding IsConfirming}">
      <TextBlock Classes="label" Text="{x:Static res:Strings.ResetConfirm}" TextWrapping="Wrap" />
      <WrapPanel Orientation="Horizontal">
        <Button Classes="pill accent" Content="{x:Static res:Strings.ResetConfirmYes}" Command="{Binding ConfirmCommand}" Margin="0,0,12,0" />
        <Button Classes="pill" Content="{x:Static res:Strings.ResetCancel}" Command="{Binding CancelCommand}" />
      </WrapPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
