<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DotaTune.ViewModels"
             xmlns:res="using:DotaTune.Resources"
             x:Class="DotaTune.Views.GameStateView"
             x:DataType="vm:GameStateViewModel">
  <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Left">
    <TextBlock Classes="title" Text="{Binding Title}" />
    <TextBlock Classes="lead" Text="{Binding Description}" />

    <Border Classes="verdict"
            Classes.ok="{Binding IsOk}"
            Classes.attention="{Binding IsAttention}"
            Classes.error="{Binding IsError}"
            Margin="0,14,0,0">
      <Grid ColumnDefinitions="Auto,*">
        <Ellipse Classes="mark" Width="8" Height="8" VerticalAlignment="Top" Margin="0,8,12,0" />
        <StackPanel Grid.Column="1" Spacing="8">
          <TextBlock Classes="label" Text="{Binding Summary}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding Action}" IsVisible="{Binding Action, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="muted" Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Grid>
    </Border>

    <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
      <Button Classes="pill accent" Content="{x:Static res:Strings.InstallPack}" Command="{Binding InstallPackCommand}"
              IsVisible="{Binding Installable}" Margin="0,0,12,12" />
      <Button Classes="pill" Classes.accent="{Binding PlayIsAccent}" Content="{x:Static res:Strings.Play}" Command="{Binding PlayCommand}"
              IsVisible="{Binding Playable}" Margin="0,0,12,12" />
      <Button Classes="pill" Content="{x:Static res:Strings.RemovePack}" Command="{Binding RemovePackCommand}"
              IsVisible="{Binding Removable}" Margin="0,0,12,12" />
      <Button Classes="pill" Content="{x:Static res:Strings.Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,12,12" />
    </WrapPanel>

    <ItemsControl ItemsSource="{Binding Groups}" Margin="0,18,0,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="26" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:FactGroup">
          <StackPanel Spacing="8">
            <TextBlock Classes="group" Text="{Binding Title}" />
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FactRow">
                  <Grid ColumnDefinitions="200,*" Margin="0,5">
                    <TextBlock Grid.Column="0" Classes="muted" Text="{Binding Label}" Margin="0,0,16,0" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
