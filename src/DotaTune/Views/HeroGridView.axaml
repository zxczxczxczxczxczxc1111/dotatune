<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DotaTune.ViewModels"
             xmlns:res="using:DotaTune.Resources"
             xmlns:v="using:DotaTune.Views"
             x:Class="DotaTune.Views.HeroGridView"
             x:DataType="vm:HeroGridViewModel">
  <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Left">
    <TextBlock Classes="title" Text="{Binding Title}" />
    <TextBlock Classes="lead" Text="{Binding Description}" />
    <TextBlock Classes="muted" Text="{Binding AccountText}"
               IsVisible="{Binding AccountText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,14,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:GridRow">
          <Grid ColumnDefinitions="*,Auto" Margin="0,10">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Name}" FontSize="16" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="{Binding Description}" />
            </StackPanel>
            <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding IsOn}" Margin="32,0,0,0"
                          AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="group" Text="{x:Static res:Strings.GridArtGroup}" Margin="0,18,0,0" />
    <ItemsControl ItemsSource="{Binding ArtRows}" Margin="0,4,0,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="2" ColumnSpacing="16" RowSpacing="16" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:GridRow">
          <Border Background="{StaticResource RaisedBrush}" CornerRadius="8">
            <StackPanel>
              <v:GridPreview Layout="{Binding Layout}" Margin="12,12,12,0" />
              <Grid ColumnDefinitions="*,Auto" Margin="16,8,16,12">
                <TextBlock Text="{Binding Name}" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding IsOn}" Margin="16,0,0,0"
                              AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="muted" Text="{x:Static res:Strings.GridMarkHint}" />

    <Border Classes="verdict" Classes.ok="{Binding IsOk}" Classes.attention="{Binding IsAttention}" Margin="0,14,0,0"
            IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid ColumnDefinitions="Auto,*">
        <Ellipse Classes="mark" Width="8" Height="8" VerticalAlignment="Top" Margin="0,8,12,0" />
        <StackPanel Grid.Column="1" Spacing="8">
          <TextBlock Classes="label" Text="{Binding Summary}" TextWrapping="Wrap" />
          <SelectableTextBlock Classes="muted" Text="{Binding Note}" TextWrapping="Wrap"
                               IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="label" Text="{Binding CloudHint}" TextWrapping="Wrap"
                     IsVisible="{Binding CloudHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Grid>
    </Border>

    <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
      <Button Classes="pill accent" Content="{x:Static res:Strings.GridApply}" Command="{Binding ApplyCommand}"
              IsVisible="{Binding CanApplyNow}" Margin="0,0,12,12" />
      <Button Classes="pill" Content="{x:Static res:Strings.GridRemoveAll}" Command="{Binding RemoveAllCommand}"
              IsVisible="{Binding CanRemoveNow}" Margin="0,0,12,12" />
      <Button Classes="pill" Content="{x:Static res:Strings.GridAddFile}" Command="{Binding AddFileCommand}" Margin="0,0,12,12" />
    </WrapPanel>

    <TextBlock Classes="group" Text="{x:Static res:Strings.GridSourceGroup}" Margin="0,18,0,0" />
    <TextBlock Classes="muted" Text="{Binding CatalogText}" />
    <WrapPanel Orientation="Horizontal" IsVisible="{Binding CanDownloadEver}">
      <Button Classes="pill" Content="{x:Static res:Strings.GridDownload}" Command="{Binding DownloadCommand}" Margin="0,0,12,12" />
    </WrapPanel>
  </StackPanel>
</UserControl>
