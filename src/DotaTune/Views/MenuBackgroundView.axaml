<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DotaTune.ViewModels"
             xmlns:res="using:DotaTune.Resources"
             x:Class="DotaTune.Views.MenuBackgroundView"
             x:DataType="vm:MenuBackgroundViewModel">
  <UserControl.Styles>
    <!-- Choices as 16:9 tiles; the chosen one gets a white ring, as the swatches of the config page. -->
    <Style Selector="ListBox.tiles">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- The item keeps 4 px around its content, so the ring around the 192x108 preview is not cut off. -->
    <Style Selector="ListBox.tiles > ListBoxItem">
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Background="Transparent">
            <ContentPresenter Name="content" Margin="4"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <Border Name="ring" Width="200" Height="116" CornerRadius="9" BorderThickness="2"
                    HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="False" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.tiles > ListBoxItem:pointerover /template/ Border#ring">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
    </Style>
    <Style Selector="ListBox.tiles > ListBoxItem:selected /template/ Border#ring">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="ListBox.tiles > ListBoxItem:focus-visible /template/ Border#ring">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
    </Style>
    <Style Selector="Border.preview">
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    </Style>
    <Style Selector="Border.preview.black">
      <Setter Property="Background" Value="#000000" />
      <Setter Property="BorderBrush" Value="{StaticResource RaisedHighlightBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Left">
    <TextBlock Classes="title" Text="{Binding Title}" />
    <TextBlock Classes="lead" Text="{Binding Description}" />

    <ListBox Classes="tiles" ItemsSource="{Binding Tiles}" SelectedItem="{Binding Selected}" SelectionMode="AlwaysSelected"
             Margin="0,14,0,0" AutomationProperties.Name="{Binding Title}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:MenuTile">
          <!-- The two plain choices carry their name on the card; a picture speaks for itself. -->
          <Border Classes="preview" Classes.black="{Binding IsBlack}" Width="192" Height="108" CornerRadius="6" ClipToBounds="True"
                  AutomationProperties.Name="{Binding Title}">
            <Panel>
              <Image Source="{Binding Preview}" Stretch="UniformToFill"
                     IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Text="{Binding Title}" Classes="muted" FontSize="16" FontWeight="Bold" Margin="12,0"
                         TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowsTitle}" />
            </Panel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Orientation="Horizontal" Spacing="10">
      <Button Classes="pill" Content="{x:Static res:Strings.MenuAddPicture}" Command="{Binding AddPictureCommand}" />
      <Button Classes="pill" Content="{x:Static res:Strings.MenuRemovePicture}" Command="{Binding RemovePictureCommand}"
              IsVisible="{Binding CanRemove}" />
    </StackPanel>
    <TextBlock Classes="muted" Text="{x:Static res:Strings.MenuPictureHint}" MaxWidth="620" HorizontalAlignment="Left" />

    <Border Classes="verdict" Classes.ok="{Binding IsOk}" Classes.attention="{Binding IsAttention}" Margin="0,14,0,0"
            IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid ColumnDefinitions="Auto,*">
        <Ellipse Classes="mark" Width="8" Height="8" VerticalAlignment="Top" Margin="0,8,12,0" />
        <StackPanel Grid.Column="1" Spacing="8">
          <TextBlock Classes="label" Text="{Binding Summary}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Grid>
    </Border>

    <Button Classes="pill accent" Content="{Binding ApplyText}" Command="{Binding ApplyCommand}"
            IsVisible="{Binding CanApplyNow}" HorizontalAlignment="Left" Margin="0,10,0,0" />
  </StackPanel>
</UserControl>
