<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DotaTune.ViewModels"
             xmlns:res="using:DotaTune.Resources"
             x:Class="DotaTune.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:AccountOption">
      <TextBlock Text="{Binding Text}" />
    </DataTemplate>
  </UserControl.DataTemplates>

  <StackPanel Spacing="32" MaxWidth="820" HorizontalAlignment="Left">
    <TextBlock Classes="title" Text="{x:Static res:Strings.NavSettings}" />

    <StackPanel Spacing="10">
      <TextBlock Classes="label" Text="{x:Static res:Strings.LanguageLabel}" />
      <!-- A new language rebuilds the window: not while the blocks below write the game files. -->
      <ComboBox ItemsSource="{Binding Languages}"
                SelectedItem="{Binding SelectedLanguage}"
                IsEnabled="{Binding !Config.IsBusy}"
                MinWidth="260">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LanguageOption">
            <TextBlock Text="{Binding Title}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Classes="muted" Text="{x:Static res:Strings.LanguageHint}" />
    </StackPanel>

    <StackPanel Spacing="10">
      <TextBlock Classes="label" Text="{x:Static res:Strings.DataFolderLabel}" />
      <SelectableTextBlock Text="{Binding DataFolder}" TextWrapping="Wrap"
                           Foreground="{StaticResource InkMutedBrush}" />
      <Button Classes="pill" Content="{x:Static res:Strings.OpenFolder}" Click="OnOpenDataFolder" HorizontalAlignment="Left" />
    </StackPanel>

    <StackPanel Spacing="10">
      <TextBlock Classes="label" Text="{x:Static res:Strings.UpdatesLabel}" />
      <TextBlock Classes="muted" Text="{Binding VersionText}" />
      <TextBlock Classes="muted" Text="{Binding Updates.Status}" />
      <WrapPanel>
        <WrapPanel.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.Or}">
            <Binding Path="Updates.CanCheck" />
            <Binding Path="Updates.CanInstallNow" />
          </MultiBinding>
        </WrapPanel.IsVisible>
        <Button Classes="pill accent" Content="{x:Static res:Strings.UpdateInstallNow}" Command="{Binding Updates.InstallNowCommand}"
                IsVisible="{Binding Updates.CanInstallNow}" />
        <Button Classes="pill" Content="{x:Static res:Strings.UpdateCheckNow}" Command="{Binding Updates.CheckNowCommand}"
                IsVisible="{Binding Updates.CanCheck}" />
      </WrapPanel>
    </StackPanel>

    <!-- The copy goes first: it is taken before anything else is changed. -->
    <StackPanel Spacing="14" DataContext="{Binding Config.Backup}" x:DataType="vm:BackupBlockViewModel">
      <TextBlock Classes="group" Text="{x:Static res:Strings.ConfigBackupGroup}" />
      <TextBlock Classes="muted" Text="{x:Static res:Strings.BackupNote}" TextWrapping="Wrap" />
      <WrapPanel Orientation="Horizontal">
        <Button Classes="pill" Content="{x:Static res:Strings.BackupSave}" Command="{Binding SaveCommand}" Margin="0,0,12,12" />
        <Button Classes="pill" Content="{x:Static res:Strings.BackupRestoreLast}" Command="{Binding RestoreLastCommand}"
                IsVisible="{Binding HasLastCopy}" Margin="0,0,12,12" />
        <Button Classes="pill" Content="{x:Static res:Strings.BackupOpenFile}" Command="{Binding OpenFileCommand}" Margin="0,0,12,12" />
        <Button Classes="pill" Content="{x:Static res:Strings.BackupUndo}" Command="{Binding UndoCommand}"
                IsVisible="{Binding CanUndo}" Margin="0,0,12,12" />
      </WrapPanel>
      <TextBlock Classes="muted" Text="{Binding LastCopyText}" TextWrapping="Wrap"
                 IsVisible="{Binding LastCopyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Border Classes="verdict" IsVisible="{Binding HasPending}">
        <StackPanel Spacing="10">
          <TextBlock Classes="label" Text="{Binding PendingTitle}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BackupPartRow">
                <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding IsChecked}" Margin="32,0,0,0"
                                AutomationProperties.Name="{Binding Title}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Classes="pill accent" Content="{Binding ApplyText}" Command="{Binding ApplyCommand}" Margin="0,0,12,0" />
            <Button Classes="pill" Content="{x:Static res:Strings.PresetCancel}" Command="{Binding CancelCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="muted" Text="{Binding Note}" TextWrapping="Wrap"
                 IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="label" Text="{Binding CloudHint}" TextWrapping="Wrap"
                 IsVisible="{Binding CloudHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <StackPanel Spacing="14" DataContext="{Binding Config.Transfer}" x:DataType="vm:TransferBlockViewModel">
      <TextBlock Classes="group" Text="{x:Static res:Strings.ConfigTransferGroup}" />
      <StackPanel Spacing="14" IsVisible="{Binding IsAvailable}">
        <Grid ColumnDefinitions="*,Auto" Margin="0,10">
          <TextBlock Text="{x:Static res:Strings.TransferFrom}" FontSize="16" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Source}" MinWidth="240"
                    Margin="32,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{x:Static res:Strings.TransferFrom}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" Margin="0,10">
          <TextBlock Text="{x:Static res:Strings.TransferTo}" FontSize="16" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Target}" MinWidth="240"
                    Margin="32,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{x:Static res:Strings.TransferTo}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TransferGroupRow">
              <Grid ColumnDefinitions="*,Auto" Margin="0,10">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}" FontSize="16" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding IsChecked}" Margin="32,0,0,0"
                              AutomationProperties.Name="{Binding Title}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <TextBlock Classes="muted" Text="{Binding Note}" TextWrapping="Wrap"
                 IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="label" Text="{Binding CloudHint}" TextWrapping="Wrap"
                 IsVisible="{Binding CloudHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <WrapPanel Orientation="Horizontal">
        <Button Classes="pill" Content="{x:Static res:Strings.TransferRun}" Command="{Binding TransferCommand}"
                IsVisible="{Binding CanTransferNow}" Margin="0,0,12,12" />
        <Button Classes="pill" Content="{x:Static res:Strings.TransferRestore}" Command="{Binding RestoreCommand}"
                IsVisible="{Binding CanRestoreNow}" Margin="0,0,12,12" />
      </WrapPanel>
    </StackPanel>

    <StackPanel Spacing="14" DataContext="{Binding Config.Presets}" x:DataType="vm:PresetBlockViewModel">
      <TextBlock Classes="group" Text="{x:Static res:Strings.ConfigPresetGroup}" />
      <TextBlock Classes="muted" Text="{x:Static res:Strings.PresetExportNote}" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto" Margin="0,10">
        <StackPanel Spacing="2">
          <TextBlock Text="{x:Static res:Strings.TransferHeroGrids}" FontSize="16" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{x:Static res:Strings.PresetFileOnly}" />
        </StackPanel>
        <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding WithHeroGrids}" Margin="32,0,0,0"
                      AutomationProperties.Name="{x:Static res:Strings.TransferHeroGrids}" VerticalAlignment="Center" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" Margin="0,10">
        <StackPanel Spacing="2">
          <TextBlock Text="{x:Static res:Strings.TransferHotkeys}" FontSize="16" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{x:Static res:Strings.PresetFileOnly}" />
        </StackPanel>
        <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding WithHotkeys}" Margin="32,0,0,0"
                      AutomationProperties.Name="{x:Static res:Strings.TransferHotkeys}" VerticalAlignment="Center" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" Margin="0,10">
        <StackPanel Spacing="2">
          <TextBlock Text="{x:Static res:Strings.TransferGameSettings}" FontSize="16" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{x:Static res:Strings.PresetFileOnly}" />
        </StackPanel>
        <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding WithGameSettings}" Margin="32,0,0,0"
                      AutomationProperties.Name="{x:Static res:Strings.TransferGameSettings}" VerticalAlignment="Center" />
      </Grid>
      <WrapPanel Orientation="Horizontal">
        <Button Classes="pill" Content="{x:Static res:Strings.PresetCopyCode}" Command="{Binding CopyCodeCommand}" Margin="0,0,12,12" />
        <Button Classes="pill" Content="{x:Static res:Strings.PresetSaveFile}" Command="{Binding SaveFileCommand}" Margin="0,0,12,12" />
      </WrapPanel>
      <SelectableTextBlock Classes="muted" Text="{Binding Code}" TextWrapping="Wrap"
                           IsVisible="{Binding Code, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
        <TextBox Classes="code" Text="{Binding ImportText}" PlaceholderText="{x:Static res:Strings.PresetCodeWatermark}"
                 AutomationProperties.Name="{x:Static res:Strings.PresetCodeWatermark}" />
        <Button Grid.Column="1" Classes="pill" Content="{x:Static res:Strings.PresetLoadCode}" Command="{Binding LoadCodeCommand}"
                Margin="12,0,0,0" VerticalAlignment="Center" />
      </Grid>
      <WrapPanel Orientation="Horizontal">
        <Button Classes="pill" Content="{x:Static res:Strings.PresetOpenFile}" Command="{Binding OpenFileCommand}" Margin="0,0,12,12" />
      </WrapPanel>

      <Border Classes="verdict" IsVisible="{Binding HasPending}">
        <StackPanel Spacing="10">
          <TextBlock Classes="label" Text="{x:Static res:Strings.PresetChangesTitle}" />
          <!-- Every line has its own switch: off leaves that line of the page as it is. -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding EffectsChange}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding ApplyEffects}" Margin="32,0,0,0"
                          AutomationProperties.Name="{Binding EffectsChange}" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding ConfigChange}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding ApplyConfig}" Margin="32,0,0,0"
                          AutomationProperties.Name="{Binding ConfigChange}" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding LaunchChange}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding ApplyLaunch}" Margin="32,0,0,0"
                          AutomationProperties.Name="{Binding LaunchChange}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="muted" Text="{Binding Unknown}" TextWrapping="Wrap"
                     IsVisible="{Binding Unknown, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasHeroGrids}">
            <TextBlock Text="{x:Static res:Strings.TransferHeroGrids}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding ApplyHeroGrids}" Margin="32,0,0,0"
                          AutomationProperties.Name="{x:Static res:Strings.TransferHeroGrids}" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasHotkeys}">
            <TextBlock Text="{x:Static res:Strings.TransferHotkeys}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding ApplyHotkeys}" Margin="32,0,0,0"
                          AutomationProperties.Name="{x:Static res:Strings.TransferHotkeys}" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasGameSettings}">
            <TextBlock Text="{x:Static res:Strings.TransferGameSettings}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding ApplyGameSettings}" Margin="32,0,0,0"
                          AutomationProperties.Name="{x:Static res:Strings.TransferGameSettings}" VerticalAlignment="Center" />
          </Grid>
          <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Classes="pill accent" Content="{x:Static res:Strings.PresetApply}" Command="{Binding ApplyCommand}" Margin="0,0,12,0" />
            <Button Classes="pill" Content="{x:Static res:Strings.PresetCancel}" Command="{Binding CancelCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="muted" Text="{Binding Note}" TextWrapping="Wrap"
                 IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </StackPanel>
</UserControl>
