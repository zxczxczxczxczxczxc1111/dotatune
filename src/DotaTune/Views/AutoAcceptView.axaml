<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DotaTune.ViewModels"
             xmlns:res="using:DotaTune.Resources"
             x:Class="DotaTune.Views.AutoAcceptView"
             x:DataType="vm:AutoAcceptViewModel">
  <UserControl.Styles>
    <!-- The delay matters only with the switch on; it dims the way a disabled switch does. -->
    <Style Selector="StackPanel.delay:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Left">
    <TextBlock Classes="title" Text="{Binding Title}" />
    <TextBlock Classes="lead" Text="{Binding Description}" />

    <Grid ColumnDefinitions="*,Auto" Margin="0,24,0,0">
      <TextBlock Text="{x:Static res:Strings.AutoAcceptSwitch}" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" />
      <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding IsOn}" Margin="32,0,0,0"
                    AutomationProperties.Name="{x:Static res:Strings.AutoAcceptSwitch}" VerticalAlignment="Center" />
    </Grid>

    <StackPanel Classes="delay" Spacing="4" IsEnabled="{Binding IsOn}" Margin="0,0,0,10">
      <TextBlock Text="{x:Static res:Strings.AutoAcceptDelay}" FontSize="16" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <Slider Width="360" Minimum="{Binding MinSeconds}" Maximum="{Binding MaxSeconds}" Value="{Binding Seconds}"
                TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"
                AutomationProperties.Name="{x:Static res:Strings.AutoAcceptDelay}" VerticalAlignment="Center" />
        <TextBlock Classes="label" Text="{Binding SecondsText}" MinWidth="40" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>

    <Border Classes="verdict" Classes.ok="{Binding IsOk}" Classes.attention="{Binding IsAttention}"
            IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid ColumnDefinitions="Auto,*">
        <Ellipse Classes="mark" Width="8" Height="8" VerticalAlignment="Top" Margin="0,8,12,0" />
        <StackPanel Grid.Column="1" Spacing="8">
          <TextBlock Classes="label" Text="{Binding Summary}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Grid>
    </Border>

    <Button Classes="pill accent" Content="{Binding ApplyText}" Command="{Binding ApplyCommand}"
            IsVisible="{Binding CanApplyNow}" HorizontalAlignment="Left" Margin="0,10,0,0" />
  </StackPanel>
</UserControl>
